# Chapa Payment Gateway Configuration
# NEVER commit this file to version control - add .env to .gitignore
CHAPA_SECRET_KEY=CHASECK-xIKMS9QBAxmkATALy8jowWPHi3ubJgka
CHAPA_PUBLIC_KEY=CHAPUBK-xIKMS9QBAxmkATALy8jowWPHi3ubJgka

# Server Configuration
PORT=3000
NODE_ENV=production

# Callback URL - Update this with your production domain
# For local development: http://localhost:3000
# For production: https://yourdomain.com
BASE_URL=https://cosap.org

# Frontend URL for CORS
FRONTEND_URL=https://cosap.org

# SMTP Email Configuration (for contact form notifications)
# Configure these to enable email notifications to info@shgconsortiumeth.org
# Example with Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
